@page "/admin/projects"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@inject AdminService AdminSvc
@inject ILogger<Index> Logger
@implements IDisposable

<PageTitle>Projects</PageTitle>

<div class="page-header">
    <h1>Projects</h1>
    <a href="/admin/projects/new" class="btn btn-primary">+ Create project</a>
</div>

@if (loading)
{
    <LoadingSkeleton RowCount="3" />
}
else if (error is not null)
{
    <ErrorBanner Message="@error" OnRetry="LoadAsync" />
}
else if (projects.Count == 0)
{
    <EmptyState Title="No projects yet"
                Message="Create your first project"
                CtaLabel="+ Create project"
                CtaHref="/admin/projects/new" />
}
else
{
    <table class="approvals-table" aria-label="Projects">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Billing type</th>
                <th scope="col">Users</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var proj in projects)
            {
                <tr style="@(proj.IsActive ? "" : "color:var(--color-text-secondary);")">
                    <td>
                        @proj.Name
                        @if (!proj.IsActive)
                        {
                            <span> (inactive)</span>
                        }
                    </td>
                    <td>@proj.BillingType</td>
                    <td>@proj.UserCount</td>
                    <td>@(proj.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        @if (proj.IsActive)
                        {
                            <a href="/admin/projects/@proj.Id" class="btn btn-sm btn-secondary"
                               aria-label="Edit project @proj.Name">Edit</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProjectSummaryDto> projects = new();
    private bool loading = true;
    private string? error;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();
        loading = true;
        error = null;
        try
        {
            projects = await AdminSvc.GetProjectsAsync(cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load projects");
            error = "We couldn't load projects. Try again.";
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose() => cts?.Cancel();
}
