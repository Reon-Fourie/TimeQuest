@inject NavigationManager Nav

<nav class="nav-rail" aria-label="Main navigation">
    <div class="nav-brand">
        <span class="nav-logo">TimeQuest</span>
    </div>

    <ul class="nav-list" role="list">

        <!-- All authenticated users — My Work -->
        <AuthorizeView>
            <Authorized>
                <li>
                    <NavLink href="/timesheet" Match="NavLinkMatch.Prefix"
                             aria-label="My Timesheet">
                        My Timesheet
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <!-- Team Lead — Approvals -->
        <AuthorizeView Roles="TeamLead">
            <Authorized>
                <li>
                    <NavLink href="/approvals" Match="NavLinkMatch.Prefix"
                             aria-label="Approvals">
                        Approvals
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <!-- Financial Admin — Finance -->
        <AuthorizeView Roles="FinancialAdmin">
            <Authorized>
                <li>
                    <NavLink href="/financial/queue" Match="NavLinkMatch.Prefix"
                             aria-label="Review Queue">
                        Review Queue
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/financial/lock" Match="NavLinkMatch.Prefix"
                             aria-label="Lock Timesheets">
                        Lock Timesheets
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/financial/reports" Match="NavLinkMatch.Prefix"
                             aria-label="Reports">
                        Reports
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/financial/export" Match="NavLinkMatch.Prefix"
                             aria-label="Export">
                        Export
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/audit" Match="NavLinkMatch.Prefix"
                             aria-label="Audit Log">
                        Audit Log
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <!-- Administrator — Administration -->
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <li>
                    <NavLink href="/admin/teams" Match="NavLinkMatch.Prefix"
                             aria-label="Teams">
                        Teams
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/admin/projects" Match="NavLinkMatch.Prefix"
                             aria-label="Projects">
                        Projects
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <!-- System Admin — System -->
        <AuthorizeView Roles="SystemAdmin">
            <Authorized>
                <li>
                    <NavLink href="/sysadmin/integrations" Match="NavLinkMatch.Prefix"
                             aria-label="Integrations">
                        Integrations
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/audit" Match="NavLinkMatch.Prefix"
                             aria-label="Audit Log">
                        Audit Log
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

    </ul>
</nav>
