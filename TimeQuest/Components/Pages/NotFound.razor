@page "/not-found"
@page "/404"
@layout MainLayout

<PageTitle>Page not found</PageTitle>

<div class="empty-state" style="padding-top:var(--space-12);">
    <h1 style="font-size:var(--font-size-2xl);margin-bottom:var(--space-3);">Page not found</h1>
    <p class="empty-state-message">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/timesheet" class="btn btn-primary">Go to my timesheet</a>
</div>
